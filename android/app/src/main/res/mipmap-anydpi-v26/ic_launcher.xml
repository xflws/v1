<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used on Android 8 and later. The launcher masks the outer
     edge to whatever shape the device uses — circle, squircle, teardrop — so
     the mark sits in the safe middle area and the brand orange fills the rest. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
